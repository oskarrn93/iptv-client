{
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "golang@oskarrn93-plugins": true,
    "typescript@oskarrn93-plugins": true,
    "git@oskarrn93-plugins": true,
    "gh-stack@oskarrn93-plugins": true
  },
  "extraKnownMarketplaces": {
    "oskarrn93-plugins": {
      "source": { "source": "github", "repo": "oskarrn93/claude-plugins" }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gofmt.mjs\"" }]
      }
    ]
  }
}
